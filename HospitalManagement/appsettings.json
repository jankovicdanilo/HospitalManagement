{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AppointmentSettings": {
    "WorkStartHour": 8,
    "WorkEndHour": 17,
    "SlotSizeMinutes": 30
  },
  "DiscountSettings": {
    "Tier1MinCount": 3,
    "Tier1Percentage": 3,
    "Tier2MinCount": 5,
    "Tier2Percentage": 4,
    "Tier3MinCount": 7,
    "Tier3Percentage": 5,
    "MaxDiscount": 100
  },
  "AllowedHosts": "*"
}